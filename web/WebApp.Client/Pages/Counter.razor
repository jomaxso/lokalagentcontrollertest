@page "/counter"
@page "/whatsapp"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable

<PageTitle>WhatsApp</PageTitle>

<h1>WhatsApp Page</h1>

<p>Hier kannst du zwei hart codierte Localhost-Aufrufe starten und die Wetterdaten direkt in einer Tabelle anzeigen.</p>

<div class="d-flex gap-2 flex-wrap">
    <button class="btn btn-success" @onclick="() => LoadWeatherAsync(HttpsUrl)"
            disabled="@(!httpsAvailable || isLoading || isCheckingAvailability)">Elmar HTTPS</button>
    <button class="btn btn-outline-success" @onclick="() => LoadWeatherAsync(HttpUrl)"
            disabled="@(!httpAvailable || isLoading || isCheckingAvailability)">Elmar HTTP</button>
</div>

@if (isCheckingAvailability)
{
    <p class="mt-3"><em>Pruefe lokale API-Endpunkte...</em></p>
}
else
{
    <p class="mt-3 text-muted">HTTPS: @(httpsAvailable ? "verfuegbar" : "nicht erreichbar") | HTTP: @(httpAvailable ?
           "verfuegbar" : "nicht erreichbar")</p>
    }

    @if (isLoading)
    {
        <p class="mt-3"><em>Lade Wetterdaten...</em></p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="mt-3 text-danger">@errorMessage</p>
    }
    else if (forecasts is not null)
    {
        <p class="mt-3"><strong>Quelle:</strong> @selectedUrl</p>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temp. (C)</th>
                    <th>Temp. (F)</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts)
                {
                    <tr>
                        <td>@forecast.Date.ToShortDateString()</td>
                        <td>@forecast.TemperatureC</td>
                        <td>@forecast.TemperatureF</td>
                        <td>@forecast.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }

@code {
    private const string HttpsUrl = "https://localhost:7266";
    private const string HttpUrl = "http://localhost:5158";
    private const string VersionPath = "/version";

    private WeatherForecast[]? forecasts;
    private string? selectedUrl;
    private string? errorMessage;
    private bool isLoading;
    private bool isCheckingAvailability = true;
    private bool httpsAvailable;
    private bool httpAvailable;
    private readonly CancellationTokenSource availabilityCancellation = new();
    private Task? availabilityMonitorTask;

    protected override void OnInitialized()
    {
        availabilityMonitorTask = MonitorEndpointAvailabilityAsync(availabilityCancellation.Token);
    }

    private async Task LoadWeatherAsync(string baseUrl)
    {
        isLoading = true;
        errorMessage = null;
        selectedUrl = baseUrl;

        try
        {
            var httpClient = new HttpClient { BaseAddress = new Uri(baseUrl) };
            forecasts = await httpClient.GetFromJsonAsync<WeatherForecast[]>("/weatherforecast") ?? [];
        }
        catch (Exception ex)
        {
            forecasts = null;
            errorMessage = $"Wetterdaten von {baseUrl} konnten nicht geladen werden: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task MonitorEndpointAvailabilityAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                httpsAvailable = await IsEndpointAvailableAsync(HttpsUrl, cancellationToken);
                httpAvailable = await IsEndpointAvailableAsync(HttpUrl, cancellationToken);
                isCheckingAvailability = false;

                await InvokeAsync(StateHasChanged);

                if (!await timer.WaitForNextTickAsync(cancellationToken))
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static async Task<bool> IsEndpointAvailableAsync(string baseUrl, CancellationToken cancellationToken)
    {
        try
        {
            using var httpClient = new HttpClient { BaseAddress = new Uri(baseUrl) };
            using var response = await httpClient.GetAsync(VersionPath, cancellationToken);
            return response.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        availabilityCancellation.Cancel();
        if (availabilityMonitorTask is not null)
        {
            await availabilityMonitorTask;
        }
        availabilityCancellation.Dispose();
    }

    private sealed record WeatherForecast(DateOnly Date, int TemperatureC, string? Summary)
    {
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
