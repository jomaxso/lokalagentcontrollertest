@page "/weather"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>Diese Seite baut die SignalR-Verbindung direkt im Browser zur lokalen API auf.</p>

<div class="d-flex gap-2 flex-wrap">
    <button class="btn btn-primary" @onclick="() => ConnectToWeatherHubAsync(HttpsHubUrl)"
            disabled="@(!httpsAvailable || isConnecting || isCheckingAvailability)">SignalR HTTPS</button>
    <button class="btn btn-outline-primary" @onclick="() => ConnectToWeatherHubAsync(HttpHubUrl)"
            disabled="@(!httpAvailable || isConnecting || isCheckingAvailability)">SignalR HTTP</button>
</div>

@if (isCheckingAvailability)
{
    <p class="mt-3"><em>Pruefe lokale API-Endpunkte...</em></p>
}
else
{
    <p class="mt-3 text-muted">HTTPS: @(httpsAvailable ? "verfuegbar" : "nicht erreichbar") | HTTP: @(httpAvailable ?
                   "verfuegbar" : "nicht erreichbar")</p>
    }

    @if (isConnecting)
    {
        <p><em>Loading...</em></p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
    }
    else if (forecasts is null)
    {
        <p><em>No data received yet.</em></p>
    }
    else
    {
        <p><strong>Quelle:</strong> @connectedHubUrl</p>

        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th aria-label="Temperature in Celsius">Temp. (C)</th>
                    <th aria-label="Temperature in Fahrenheit">Temp. (F)</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts)
                {
                    <tr>
                        <td>@forecast.Date.ToShortDateString()</td>
                        <td>@forecast.TemperatureC</td>
                        <td>@forecast.TemperatureF</td>
                        <td>@forecast.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }

@code {
    private const string HttpsApiUrl = "https://localhost:7266";
    private const string HttpApiUrl = "http://localhost:5158";
    private const string HttpsHubUrl = "https://localhost:7266/weatherhub";
    private const string HttpHubUrl = "http://localhost:5158/weatherhub";
    private const string VersionPath = "/version";

    private HubConnection? hubConnection;
    private WeatherForecast[]? forecasts;
    private string? connectedHubUrl;
    private string? errorMessage;
    private bool isConnecting;
    private bool isCheckingAvailability = true;
    private bool httpsAvailable;
    private bool httpAvailable;
    private readonly CancellationTokenSource availabilityCancellation = new();
    private Task? availabilityMonitorTask;

    protected override void OnInitialized()
    {
        availabilityMonitorTask = MonitorEndpointAvailabilityAsync(availabilityCancellation.Token);
    }

    private async Task ConnectToWeatherHubAsync(string hubUrl)
    {
        Exception? lastException = null;
        isConnecting = true;
        errorMessage = null;

        try
        {
            if (hubConnection is not null)
            {
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<WeatherForecast[]>("ReceiveWeatherForecast", async receivedForecasts =>
            {
                forecasts = receivedForecasts;
                errorMessage = null;
                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
            connectedHubUrl = hubUrl;
            await hubConnection.SendAsync("RequestWeatherForecast");
        }
        catch (Exception ex)
        {
            lastException = ex;

            if (hubConnection is not null)
            {
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }
        }
        finally
        {
            isConnecting = false;
        }

        if (lastException is not null)
        {
            errorMessage = $"Die SignalR-Verbindung vom Browser zur lokalen API konnte nicht aufgebaut werden: {lastException.Message}";
        }
    }

    private async Task MonitorEndpointAvailabilityAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                httpsAvailable = await IsEndpointAvailableAsync(HttpsApiUrl, cancellationToken);
                httpAvailable = await IsEndpointAvailableAsync(HttpApiUrl, cancellationToken);
                isCheckingAvailability = false;

                await InvokeAsync(StateHasChanged);

                if (!await timer.WaitForNextTickAsync(cancellationToken))
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static async Task<bool> IsEndpointAvailableAsync(string baseUrl, CancellationToken cancellationToken)
    {
        try
        {
            using var httpClient = new HttpClient { BaseAddress = new Uri(baseUrl) };
            using var response = await httpClient.GetAsync(VersionPath, cancellationToken);
            return response.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    private sealed class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }

    public async ValueTask DisposeAsync()
    {
        availabilityCancellation.Cancel();

        if (availabilityMonitorTask is not null)
        {
            await availabilityMonitorTask;
        }

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }

        availabilityCancellation.Dispose();
    }
}